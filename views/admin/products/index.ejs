<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">Products</h1>
  <a href="/admin/products/new" class="btn btn-primary">Add product</a>
</div>

<div class="table-responsive">
  <table class="table align-middle table-striped">
    <thead>
      <tr>
        <th>Name</th>
        <th>Category</th>
        <th>Price</th>
        <th>Stock</th>
        <th>Updated</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(function(product){ %>
        <tr>
          <td><%= product.name %></td>
          <td><span class="badge bg-light text-dark"><%= product.category %></span></td>
          <td>$<%= product.price %></td>
          <td><%= product.stock %></td>
          <td><%= product.updatedAt ? product.updatedAt.toLocaleDateString() : "" %></td>
          <td class="text-end">
            <div class="btn-group">
              <a class="btn btn-sm btn-outline-primary" href="/products/<%= product._id %>" target="_blank">View</a>
              <a class="btn btn-sm btn-secondary" href="/admin/products/<%= product._id %>/edit">Edit</a>
              <form action="/admin/products/<%= product._id %>/delete" method="post" class="d-inline">
                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
              </form>
            </div>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

