<header class="top-bar">
  <div class="container d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div class="d-flex align-items-center gap-3">
      <i class="fa-solid fa-bag-shopping text-primary"></i>
      <span class="fw-semibold text-muted">Handmade Express Shop</span>
    </div>
    <div class="d-flex align-items-center gap-3 small text-muted">
      <span><i class="fa-regular fa-envelope me-1"></i> support@example.com</span>
      <span><i class="fa-solid fa-phone me-1"></i> +92 324 4717184</span>
    </div>
  </div>
</header>

<nav class="navbar navbar-expand-lg sticky-top main-nav">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/products">Handmade</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
      aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 main-nav-list">
        <li class="nav-item">
          <a class="nav-link <%= typeof pagetitle != 'undefined' && pagetitle.includes('Shop') ? 'active' : '' %>"
            href="/products">Products</a>
        </li>
        <li class="nav-item"><a class="nav-link" href="/cart">Cart</a></li>
        <li class="nav-item"><a class="nav-link" href="/stories">Stories</a></li>
        <li class="nav-item"><a class="nav-link" href="/contact-us">Contact</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin">Admin</a></li>
      </ul>
      <ul class="navbar-nav mb-2 mb-lg-0">
        <% if(!user) { %>
          <li class="nav-item"><a href="/register" class="nav-link">Register</a></li>
          <li class="nav-item"><a href="/login" class="nav-link">Login</a></li>
          <% } else { %>
            <li class="nav-item"><span class="nav-link disabled">Hi, <%= user.name || 'User' %></span></li>
            <li class="nav-item"><a href="/logout" class="nav-link">Logout</a></li>
            <% } %>
      </ul>
    </div>
  </div>
</nav>