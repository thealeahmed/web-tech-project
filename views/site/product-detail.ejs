<section class="container py-5">
  <div class="row g-4">
    <div class="col-md-5">
      <% if (product.image) { %>
        <img src="/images/uploaded/<%= product.image %>" class="img-fluid rounded shadow-sm" alt="<%= product.name %>">
      <% } else { %>
        <div class="placeholder-img rounded d-flex align-items-center justify-content-center text-muted">No image</div>
      <% } %>
    </div>
    <div class="col-md-7">
      <p class="text-uppercase text-muted mb-1"><%= product.category %></p>
      <h1 class="h3 mb-3"><%= product.name %></h1>
      <p class="lead">$<%= product.price %></p>
      <p class="text-muted"><%= product.description %></p>
      <div class="d-flex gap-2">
        <a href="/add-cart/<%= product._id %>" class="btn btn-primary">Add to cart</a>
        <a href="/products" class="btn btn-outline-secondary">Back to products</a>
      </div>
    </div>
  </div>
</section>

