<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Checkout | Handmade Shop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        :root {
            --primary-color: #6366f1;
            --primary-hover: #4f46e5;
            --bg-color: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
        }

        body {
            background-color: var(--bg-color);
            font-family: 'Outfit', sans-serif;
            color: var(--text-main);
            min-height: 100vh;
        }

        .checkout-wrapper {
            max-width: 1000px;
            margin: 40px auto;
            padding: 20px;
        }

        .checkout-header {
            margin-bottom: 40px;
            text-align: center;
        }

        .checkout-header h1 {
            font-weight: 700;
            font-size: 2.5rem;
            background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }

        .checkout-header p {
            color: var(--text-muted);
            font-size: 1.1rem;
        }

        .glass-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            padding: 40px;
            height: 100%;
            transition: transform 0.3s ease;
        }

        .section-title {
            font-weight: 600;
            font-size: 1.25rem;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-title i {
            color: var(--primary-color);
        }

        .form-control {
            border-radius: 12px;
            padding: 12px 16px;
            border: 1px solid var(--border-color);
            background-color: #fdfdfd;
            transition: all 0.2s ease;
        }

        .form-control:focus {
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
            border-color: var(--primary-color);
        }

        .form-label {
            font-weight: 500;
            color: var(--text-main);
            margin-bottom: 8px;
        }

        .summary-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid var(--border-color);
        }

        .summary-item:last-child {
            border-bottom: none;
        }

        .summary-item .item-info h6 {
            margin-bottom: 2px;
            font-weight: 600;
        }

        .summary-item .item-info span {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .total-section {
            background: #f1f5f9;
            margin: 20px -40px -40px -40px;
            padding: 30px 40px;
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .total-price {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary-color);
        }

        .btn-pay {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 16px;
            font-weight: 600;
            font-size: 1.1rem;
            width: 100%;
            margin-top: 30px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
        }

        .btn-pay:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(99, 102, 241, 0.35);
            color: white;
        }

        .btn-back {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.95rem;
            transition: color 0.2s ease;
        }

        .btn-back:hover {
            color: var(--primary-color);
        }

        .secure-badge {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: #10b981;
            font-size: 0.85rem;
            margin-top: 20px;
            font-weight: 500;
        }

        @media (max-width: 768px) {
            .checkout-wrapper {
                margin: 20px auto;
            }

            .glass-card {
                padding: 25px;
            }

            .total-section {
                margin: 20px -25px -25px -25px;
                padding: 20px 25px;
            }
        }
    </style>
</head>

<body>
    <div class="checkout-wrapper">
        <div class="checkout-header">
            <h1>Checkout</h1>
            <p>Complete your purchase securely in just a few clicks.</p>
        </div>

        <div class="row g-5">
            <div class="col-lg-7">
                <div class="glass-card">
                    <h5 class="section-title">
                        <i class="fas fa-user-circle"></i>
                        Customer Information
                    </h5>
                    <form action="/checkout" method="POST" id="checkoutForm">
                        <div class="mb-4">
                            <label for="fullName" class="form-label">Full Name</label>
                            <input name="fullName" id="fullName" class="form-control" type="text"
                                placeholder="e.g. John Doe" required>
                        </div>
                        <div class="mb-4">
                            <label for="email" class="form-label">Email Address</label>
                            <input name="email" id="email" class="form-control" type="email"
                                placeholder="john@example.com" required>
                        </div>

                        <div class="mt-5 pt-3 border-top">
                            <p class="text-muted small mb-0">
                                <i class="fas fa-info-circle me-1"></i>
                                By proceeding, you agree to our Terms of Service and Privacy Policy.
                            </p>
                            <button type="submit" class="btn btn-pay">
                                <i class="fas fa-lock me-2"></i>
                                Place My Order
                            </button>
                            <a href="/cart" class="btn btn-back">
                                <i class="fas fa-arrow-left me-1"></i>
                                Return to Shopping Cart
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="glass-card d-flex flex-column h-100">
                    <h5 class="section-title">
                        <i class="fas fa-shopping-bag"></i>
                        Order Summary
                    </h5>
                    <div class="flex-grow-1">
                        <% let total=0; %>
                            <% cart.forEach(item=> { %>
                                <% total +=item.price * item.quantity; %>
                                    <div class="summary-item">
                                        <div class="item-info">
                                            <h6>
                                                <%= item.name %>
                                            </h6>
                                            <span>Quantity: <%= item.quantity %></span>
                                        </div>
                                        <div class="item-price">
                                            <strong>Rs <%= item.price * item.quantity %></strong>
                                        </div>
                                    </div>
                                    <% }) %>
                    </div>

                    <div class="total-section">
                        <div>
                            <span class="text-muted small d-block">Grand Total</span>
                            <span class="total-price">Rs <%= total %></span>
                        </div>
                        <div class="text-end text-muted small">
                            VAT Included
                        </div>
                    </div>
                </div>
                <div class="secure-badge">
                    <i class="fas fa-shield-check"></i>
                    SSL Secure & Encrypted Payment
                </div>
            </div>
        </div>
    </div>
</body>

</html>